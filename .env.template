# ============================================================
# Environment Variables Template
# Copy to .env and fill in all values before deploying
# ============================================================

# ── Network ────────────────────────────────────────────────
DOMAIN=example.com
GATEWAY_IP=192.168.1.10
AGENT_IP=192.168.1.11
INFERENCE_IP=192.168.1.12
NAS_IP=192.168.1.13
TIMEZONE=America/New_York

# ── Home Assistant (external VM — not deployed from this repo) ──
# Using LAN IP directly so containers don't depend on Pi-hole DNS
HA_URL=http://192.168.x.x:8123
# HA → Profile → Security → Long-Lived Access Tokens → Create token
HA_TOKEN=

# ── Gateway: Caddy (Route53 DNS-01 for automatic TLS certs) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_HOSTED_ZONE_ID=
AWS_REGION=us-east-1

# ── Gateway: Authentik (SSO) ─────────────────────────────
AUTHENTIK_SECRET_KEY=
AUTHENTIK_DB_PASSWORD=

# ── Gateway: Pi-hole ───────────────────────────────────────
PIHOLE_PASSWORD=

# ── Gateway: NUT (UPS Management) ──────────────────────────
NUT_USER=admin
NUT_PASSWORD=

# ── Agent: Grafana ─────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=

# ── Agent: Phase 2 (agent-orchestrator, open-webui) ────────
# Open WebUI API key — get from Open WebUI admin panel after first boot.
# Used by mcp-notifications to inject async task results into chat.
WEBUI_API_KEY=sk-placeholder

# ── Agent: Paperless-NGX (Phase 3) ─────────────────────────
PAPERLESS_DB_PASSWORD=
PAPERLESS_SECRET_KEY=
# Get from Paperless admin UI after first boot; used by paperless-ai
PAPERLESS_API_TOKEN=

# ── Inference: SpeechBrain image (Phase 2) ─────────────────
# Prebuilt image from .github/workflows/build-speechbrain.yml.
# Pin a specific tag (e.g. :sha-abc1234) for reproducible deploys.
SPEECHBRAIN_IMAGE=ghcr.io/brainstain/speechbrain-speaker-id:latest
