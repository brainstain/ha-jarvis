# ============================================================
# Caddy reverse proxy — homelab AI agent
# TLS via Route53 DNS-01 (no port-forwarding required)
# Install at: servers/gateway/caddy/Caddyfile
# ============================================================

{
	email admin@michaelgoldstein.co
	acme_dns route53 {
		access_key_id   {env.AWS_ACCESS_KEY_ID}
		secret_access_key {env.AWS_SECRET_ACCESS_KEY}
		region          {env.AWS_REGION}
	}
}

# ── Gateway node services (same Docker network — proxy by container name) ──

authentik.michaelgoldstein.co {
	reverse_proxy authentik-server:9000
}

search.michaelgoldstein.co {
	reverse_proxy searxng:8080
}

uptime.michaelgoldstein.co {
	reverse_proxy uptime-kuma:3001
}

pihole.michaelgoldstein.co {
	reverse_proxy pihole:80 {
		# Pi-hole v6 only serves the web UI when Host matches webserver.domain (pi.hole).
		# Override so Caddy forwards the expected host rather than the public subdomain.
		header_up Host pi.hole
	}
}

# ── Agent node services (cross-node — proxy via LAN IP:port) ───────────────

grafana.michaelgoldstein.co {
	reverse_proxy 192.168.13.22:3100
}

webui.michaelgoldstein.co {
	reverse_proxy 192.168.13.22:3000
}

