# ============================================================
# Pi-hole local DNS overrides
# Split-horizon: these records only apply to clients using
# Pi-hole as their resolver. Public DNS for michaelgoldstein.co
# can point the same names elsewhere for off-network access.
#
# Install at: servers/gateway/pihole/custom.list
# Mounted read-only into the pihole container in docker-compose.yml
# ============================================================

# ── Nodes ────────────────────────────────────────────────────
192.168.13.29   gateway.michaelgoldstein.co
192.168.13.22   agent.michaelgoldstein.co
192.168.13.15   inference.michaelgoldstein.co
192.168.13.26   nas.michaelgoldstein.co
192.168.13.20   ha.michaelgoldstein.co

# ── Services fronted by Caddy — all resolve to Gateway IP ───
# Caddy terminates TLS here and proxies internally to the
# correct backend node/port. Add more lines as new routes
# are added to the Caddyfile.
192.168.13.29   authentik.michaelgoldstein.co
192.168.13.29   search.michaelgoldstein.co
192.168.13.29   uptime.michaelgoldstein.co
192.168.13.29   pihole.michaelgoldstein.co
192.168.13.29   grafana.michaelgoldstein.co
192.168.13.29   webui.michaelgoldstein.co
192.168.13.29   prometheus.michaelgoldstein.co
192.168.13.29   litellm.michaelgoldstein.co
192.168.13.29   perplexica.michaelgoldstein.co
192.168.13.29   qdrant.michaelgoldstein.co
192.168.13.29   paperless.michaelgoldstein.co
192.168.13.29   paperless-ai.michaelgoldstein.co
# 192.168.13.29 agent-api.michaelgoldstein.co   # add once Agent Orchestrator is deployed (Phase 2)
