{
  "$comment": "MCP servers available to the orchestrator. Servers disabled by default are ready to enable once deployed.",
  "servers": [
    {
      "name": "ha-mcp",
      "transport": "sse",
      "url": "${HA_URL}/mcp",
      "headers": {
        "Authorization": "Bearer ${HA_TOKEN}"
      },
      "categories": ["home_assistant"],
      "enabled": true,
      "timeout": 30
    },
    {
      "name": "mcp-memory-scoped",
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "mcp_memory_scoped"],
      "categories": ["memory"],
      "enabled": true,
      "timeout": 30
    },
    {
      "name": "mcp-notifications",
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "mcp_notifications"],
      "categories": ["notifications"],
      "enabled": true,
      "timeout": 15
    },
    {
      "name": "mcp-workflow-status",
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "mcp_workflow_status"],
      "categories": ["notifications"],
      "enabled": true,
      "timeout": 10
    },
    {
      "name": "mcp-filesystem",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/mnt/nas"],
      "categories": ["filesystem", "documents"],
      "enabled": false,
      "timeout": 30,
      "$comment": "Enable once NFS mounts are working and paperless Phase 3 is up"
    },
    {
      "name": "mcp-fetch",
      "transport": "stdio",
      "command": "uvx",
      "args": ["mcp-fetch"],
      "categories": ["search"],
      "enabled": false,
      "timeout": 30,
      "$comment": "Enable once Phase 3 is deployed"
    },
    {
      "name": "mcp-playwright",
      "transport": "sse",
      "url": "http://localhost:8101/sse",
      "categories": ["browser"],
      "enabled": false,
      "timeout": 60,
      "$comment": "Phase 2 — playwright-mcp container must be running"
    },
    {
      "name": "mcp-calendar",
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "mcp_calendar"],
      "categories": ["calendar"],
      "enabled": false,
      "timeout": 20,
      "$comment": "Enable once Phase 2 is running; CALENDAR_PROVIDER=ha (default) uses HA Google Calendar"
    },
    {
      "name": "mcp-shopping-list",
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "mcp_shopping_list"],
      "categories": ["home_assistant"],
      "enabled": false,
      "timeout": 10,
      "$comment": "Phase 4 — wraps HA shopping list API"
    },
    {
      "name": "mcp-routines",
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "mcp_routines"],
      "categories": ["home_assistant"],
      "enabled": false,
      "timeout": 15,
      "$comment": "Phase 4 — stores automation routines in Qdrant"
    }
  ],
  "tool_routing": {
    "max_tools_per_request": 7,
    "category_priority": ["home_assistant", "memory", "notifications"],
    "always_include_categories": ["memory", "notifications"]
  }
}
